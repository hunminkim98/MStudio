<Window x:Class="MStudio.App.Views.BodyKinematicsInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BodyKinematics Analysis Setup"
        Width="450" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#3A3A5A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#252535" CornerRadius="12,12,0,0" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Height="45">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <Border Background="#1E4F2E" CornerRadius="3" Padding="6,3" Margin="0,0,10,0">
                            <TextBlock Text="OpenSim" Foreground="#7ED957" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="BodyKinematics Analysis" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Width="35" Height="35" HorizontalAlignment="Right" 
                            Click="CloseButton_Click" Background="Transparent" Foreground="#888" 
                            BorderThickness="0" FontSize="14" Cursor="Hand" Margin="5,0"/>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="25,20">
                <TextBlock Text="Subject Information" Foreground="#888" FontSize="12" Margin="0,0,0,15"/>
                
                <!-- Body Mass and Height Input -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="Body Mass (kg)" Foreground="#CCC" FontSize="13" Margin="0,0,0,8"/>
                        <TextBox x:Name="MassInput" Text="70" Height="32"
                                 Background="#2A2A3E" Foreground="#E0E0E0" BorderBrush="#3A3A5A" 
                                 FontSize="14" Padding="8,6" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Height (m)" Foreground="#CCC" FontSize="13" Margin="0,0,0,8"/>
                        <TextBox x:Name="HeightInput" Text="1.70" Height="32"
                                 Background="#2A2A3E" Foreground="#E0E0E0" BorderBrush="#3A3A5A" 
                                 FontSize="14" Padding="8,6" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Info Box -->
                <Border Background="#2A2A3E" CornerRadius="6" Padding="15,12" Margin="0,5,0,0">
                    <StackPanel>
                        <TextBlock Text="This analysis will perform:" Foreground="#E0E0E0" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="1. Model Scaling (based on markers)" Foreground="#AAA" FontSize="11"/>
                            <TextBlock Text="2. Inverse Kinematics (joint angles)" Foreground="#AAA" FontSize="11"/>
                            <TextBlock Text="3. BodyKinematics (Center of Mass)" Foreground="#AAA" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Text="Output files will be saved in opensim_output folder." Foreground="#6C9BDB" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#252535" CornerRadius="0,0,12,12" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="80" Height="32" Click="CloseButton_Click"
                            Background="#3A3A5A" Foreground="#AAA" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Run Analysis" Width="110" Height="32" Click="RunButton_Click"
                            Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
