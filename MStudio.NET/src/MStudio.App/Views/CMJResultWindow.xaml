<Window x:Class="MStudio.App.Views.CMJResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMJ Analysis Results"
        Width="900" Height="700"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#3A3A5A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#252535" CornerRadius="12,12,0,0" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Height="50">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <Path Data="M8,14 L8,6 M8,6 L6,8 M8,6 L10,8 M5,14 L11,14 M6,3 L8,1 L10,3" 
                              Stroke="#6C9BDB" StrokeThickness="2" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                        <TextBlock Text="CMJ Analysis Results" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Width="40" Height="40" HorizontalAlignment="Right" Click="CloseButton_Click"
                            Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <!-- Subject Info -->
                    <Border Background="#252535" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Subject Information" Foreground="#888" FontSize="12" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Gender: " Foreground="#AAA" FontSize="13"/>
                                <TextBlock x:Name="GenderText" Text="Male" Foreground="#E0E0E0" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="   |   Body Mass: " Foreground="#AAA" FontSize="13"/>
                                <TextBlock x:Name="MassText" Text="70 kg" Foreground="#E0E0E0" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hip/Knee Ratio Card -->
                    <Border Background="#252535" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel>
                                <TextBlock Text="Hip/Knee Moment Ratio" Foreground="#888" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock x:Name="RatioText" Text="1.15" Foreground="#E0E0E0" FontSize="32" FontWeight="Bold"/>
                                <Border x:Name="DominanceBadge" Background="#1E4F2E" CornerRadius="4" Padding="10,5" 
                                        HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <TextBlock x:Name="DominanceText" Text="Hip Dominant" Foreground="#7ED957" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Gauge Visual -->
                            <Grid Grid.Column="1" Width="120" Height="80">
                                <Ellipse Width="120" Height="120" Stroke="#3A3A5A" StrokeThickness="8" 
                                         StrokeDashArray="1,0.3" Margin="0,-20,0,0"/>
                                <TextBlock Text="Ratio" Foreground="#666" FontSize="11" 
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Knee Valgus Cards -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Knee -->
                        <Border Background="#252535" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Left Knee Valgus" Foreground="#888" FontSize="12" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="LeftValgusText" Text="8.2°" Foreground="#E0E0E0" FontSize="28" FontWeight="Bold"/>
                                    <Border x:Name="LeftValgusRisk" Background="#1E3A5F" CornerRadius="4" Padding="8,4" 
                                            VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock x:Name="LeftValgusRiskText" Text="Normal" Foreground="#6C9BDB" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="LeftValgusRange" Text="Normal: 3° - 8°" Foreground="#666" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Right Knee -->
                        <Border Grid.Column="2" Background="#252535" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Right Knee Valgus" Foreground="#888" FontSize="12" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="RightValgusText" Text="7.8°" Foreground="#E0E0E0" FontSize="28" FontWeight="Bold"/>
                                    <Border x:Name="RightValgusRisk" Background="#1E3A5F" CornerRadius="4" Padding="8,4" 
                                            VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock x:Name="RightValgusRiskText" Text="Normal" Foreground="#6C9BDB" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="RightValgusRange" Text="Normal: 3° - 8°" Foreground="#666" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Key Frames -->
                    <Border Background="#252535" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Key Frames" Foreground="#888" FontSize="12" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="LowestFrameText" Text="45" Foreground="#E0E0E0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Lowest CoM" Foreground="#888" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TakeoffFrameText" Text="62" Foreground="#E0E0E0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Take-off" Foreground="#888" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="LandingFrameText" Text="98" Foreground="#E0E0E0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Landing" Foreground="#888" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Phases Timeline -->
                    <Border Background="#252535" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Detected Phases" Foreground="#888" FontSize="12" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="PhasesControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2A2A3E" CornerRadius="4" Padding="12,8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Phase}" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#888" FontSize="12" Margin="15,0"/>
                                                <TextBlock Grid.Column="2" Foreground="#6C9BDB" FontSize="12">
                                                    <Run Text="Frame "/>
                                                    <Run Text="{Binding StartFrame}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding EndFrame}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- GRF Metrics (OpenSim) -->
                    <Border x:Name="GRFSection" Background="#252535" CornerRadius="8" Padding="20" Margin="0,0,0,15"
                            Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Ground Reaction Force" Foreground="#888" FontSize="12"/>
                                <Border Background="#1E4F2E" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock Text="OpenSim" Foreground="#7ED957" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PeakGRFText" Text="1496" Foreground="#FF6B6B" FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text=" N" Foreground="#FF6B6B" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PeakGRFBWText" Text="(2.18 BW)" Foreground="#888" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Peak GRF" Foreground="#888" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="NetImpulseText" Text="159.6" Foreground="#A78BFA" FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text=" N·s" Foreground="#A78BFA" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock Text="Net Impulse" Foreground="#888" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="RFDText" Text="4455" Foreground="#F59E0B" FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text=" N/s" Foreground="#F59E0B" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock Text="RFD" Foreground="#888" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Jump Metrics -->
                    <Border Background="#252535" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Jump Performance" Foreground="#888" FontSize="12" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="JumpHeightText" Text="0.32 m" Foreground="#7ED957" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Jump Height" Foreground="#888" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="FlightTimeText" Text="0.52 s" Foreground="#6C9BDB" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Flight Time" Foreground="#888" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ContactTimeText" Text="0.75 s" Foreground="#FFB347" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Contact Time" Foreground="#888" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
