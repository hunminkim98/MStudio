<Window x:Class="MStudio.App.Views.CMJInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMJ Analysis Setup"
        Width="400" Height="370"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#3A3A5A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#252535" CornerRadius="12,12,0,0" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Height="45">
                    <TextBlock Text="CMJ Analysis Setup" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="20,0"/>
                    <Button Content="✕" Width="35" Height="35" HorizontalAlignment="Right" 
                            Click="CloseButton_Click" Background="Transparent" Foreground="#888" 
                            BorderThickness="0" FontSize="14" Cursor="Hand" Margin="5,0"/>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="25,20">
                <TextBlock Text="Subject Information" Foreground="#888" FontSize="12" Margin="0,0,0,15"/>
                
                <!-- Gender Selection -->
                <TextBlock Text="Gender" Foreground="#CCC" FontSize="13" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="MaleRadio" Content="Male" GroupName="Gender" IsChecked="True"
                                 Foreground="#E0E0E0" FontSize="14" Margin="0,0,10,0"/>
                    <RadioButton x:Name="FemaleRadio" Grid.Column="1" Content="Female" GroupName="Gender"
                                 Foreground="#E0E0E0" FontSize="14"/>
                </Grid>
                
                <!-- Body Mass Input -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="Body Mass (kg)" Foreground="#CCC" FontSize="13" Margin="0,0,0,8"/>
                        <TextBox x:Name="MassInput" Text="70" Height="32"
                                 Background="#2A2A3E" Foreground="#E0E0E0" BorderBrush="#3A3A5A" 
                                 FontSize="14" Padding="8,6" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Height (m)" Foreground="#CCC" FontSize="13" Margin="0,0,0,8"/>
                        <TextBox x:Name="HeightInput" Text="1.70" Height="32"
                                 Background="#2A2A3E" Foreground="#E0E0E0" BorderBrush="#3A3A5A" 
                                 FontSize="14" Padding="8,6" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Estimate GRF Option -->
                <Border Background="#1E3A5F" CornerRadius="6" Padding="12,10" Margin="0,5,0,0">
                    <StackPanel>
                        <CheckBox x:Name="EstimateGRFCheck" IsChecked="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estimate GRF" Foreground="#E0E0E0" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="Requires BodyKinematics output (run from Analysis menu first)" 
                                   Foreground="#6C9BDB" FontSize="11" Margin="20,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#252535" CornerRadius="0,0,12,12" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="80" Height="32" Click="CloseButton_Click"
                            Background="#3A3A5A" Foreground="#AAA" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Run Analysis" Width="100" Height="32" Click="RunButton_Click"
                            Background="#4A7DBA" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
