<UserControl x:Class="MStudio.App.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:MStudio.App.Behaviors"
             xmlns:converters="clr-namespace:MStudio.App.Converters"
             xmlns:vm="clr-namespace:MStudio.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    
    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:AddConverter x:Key="AddConverter"/>
        
        <!-- Grid Lines Template for reuse -->
        <ControlTemplate x:Key="GridLinesTemplate">
            <Grid Opacity="0.15" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" Fill="White" Opacity="0.7"/>
                <Rectangle Grid.Row="1" VerticalAlignment="Bottom" Height="1" Fill="White"/>
                <Rectangle Grid.Row="2" VerticalAlignment="Bottom" Height="1" Fill="White" Opacity="0.7"/>
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>
    
    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="22"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>   <!-- Graph area -->
        </Grid.RowDefinitions>
        
        <!-- TOP TOOLBAR (outside graph area) -->
        <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Edit Mode Indicator -->
                <Border Grid.Column="0" 
                        Background="#2D5A27" CornerRadius="3" Padding="6,2" Margin="4,2"
                        Visibility="{Binding IsEditModeEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="EDIT MODE" Foreground="#90EE90" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>
                
                <!-- Display Mode Selection -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,2">
                    <!-- Value Visibility Toggle (Eye Icon) -->
                    <ToggleButton IsChecked="{Binding IsValueVisible}" Width="18" Height="18" Margin="0,0,4,0"
                                  Background="Transparent" BorderThickness="0"
                                  VerticalAlignment="Center"
                                  FocusVisualStyle="{x:Null}"
                                  ToolTip="Show Values">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                    <Viewbox Width="12.5" Height="12.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Eye Icon Path -->
                                        <Path x:Name="EyePath" 
                                              Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                              Fill="{DynamicResource B_TextDim}"/>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="EyePath" Property="Fill" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Graph Icon -->
                    <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2v-3h2v3zm4 0h-2v-5h2v5z"
                              Fill="{DynamicResource B_TextDim}"/>
                    </Viewbox>
                    
                    <!-- Display Mode Dropdown -->
                    <ComboBox ItemsSource="{Binding DisplayModes}"
                              SelectedItem="{Binding SelectedDisplayMode}"
                              Background="#333333"
                              BorderThickness="1"
                              BorderBrush="#444444"
                              Foreground="White"
                              FontSize="10"
                              Width="95"
                              Padding="4,2"
                              Focusable="False">
                        <!-- Removed ItemTemplate to allow SelectedItem to use ComboBox.Foreground (White) -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <!-- Ensure list items are black for visibility on white/light popup background -->
                                <Setter Property="Foreground" Value="Black"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>  <!-- Y-axis labels -->
                <ColumnDefinition Width="*"/>   <!-- Graph area -->
            </Grid.ColumnDefinitions>

            <!-- Y-Axis Labels (Combined Mode Only) -->
            <Grid Grid.Column="0" Margin="2,5" Visibility="{Binding IsCombinedOrSingleMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding YAxisMax}" Foreground="{DynamicResource B_TextDim}" 
                           FontSize="9" FontFamily="Consolas"
                           VerticalAlignment="Top" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding YAxisMid}" Foreground="{DynamicResource B_TextDim}" 
                           FontSize="9" FontFamily="Consolas"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding YAxisMin}" Foreground="{DynamicResource B_TextDim}" 
                           FontSize="9" FontFamily="Consolas"
                           VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Grid>
            
            <!-- Graph Area Container -->
            <Grid Grid.Column="1">
                
                <!-- COMBINED/SINGLE MODE: Single graph with all/selected curves -->
                <Grid x:Name="CombinedGraphArea"
                      Background="Transparent"
                      Visibility="{Binding IsCombinedOrSingleMode, Converter={StaticResource BoolToVisibilityConverter}}"
                      behaviors:SizeObserverBehavior.IsEnabled="True"
                      behaviors:SizeObserverBehavior.ObservedWidth="{Binding ViewWidth, Mode=OneWayToSource}"
                      behaviors:SizeObserverBehavior.ObservedHeight="{Binding ViewHeight, Mode=OneWayToSource}"
                      behaviors:MouseSeekBehavior.IsEnabled="True"
                      behaviors:MouseSeekBehavior.SeekCommand="{Binding SeekCommand}"
                      behaviors:RangeSelectionBehavior.IsEnabled="{Binding IsEditModeEnabled}"
                      behaviors:RangeSelectionBehavior.StartSelectionCommand="{Binding StartSelectionCommand}"
                      behaviors:RangeSelectionBehavior.UpdateSelectionCommand="{Binding UpdateSelectionCommand}"
                      behaviors:RangeSelectionBehavior.EndSelectionCommand="{Binding EndSelectionCommand}">
                    
                    <!-- Background Grid Lines -->
                    <Control Template="{StaticResource GridLinesTemplate}"/>

                    <!-- Selection Highlight -->
                    <Canvas IsHitTestVisible="False" Visibility="{Binding SelectionVisibility}">
                        <Rectangle Canvas.Left="{Binding SelectionLeft}"
                                   Width="{Binding SelectionWidth}"
                                   Height="{Binding ViewHeight}"
                                   Fill="#40808000"/>
                        <Line X1="{Binding SelectionLeft}" Y1="0" 
                              X2="{Binding SelectionLeft}" Y2="{Binding ViewHeight}"
                              Stroke="#CCCC00" StrokeThickness="1"/>
                        <Line Y1="0" Y2="{Binding ViewHeight}" Stroke="#CCCC00" StrokeThickness="1">
                            <Line.X1>
                                <MultiBinding Converter="{StaticResource AddConverter}">
                                    <Binding Path="SelectionLeft"/>
                                    <Binding Path="SelectionWidth"/>
                                </MultiBinding>
                            </Line.X1>
                            <Line.X2>
                                <MultiBinding Converter="{StaticResource AddConverter}">
                                    <Binding Path="SelectionLeft"/>
                                    <Binding Path="SelectionWidth"/>
                                </MultiBinding>
                            </Line.X2>
                        </Line>
                        <Border Canvas.Bottom="2" Background="#AA000000" CornerRadius="2" Padding="3,1">
                            <Canvas.Left>
                                <Binding Path="SelectionLeft"/>
                            </Canvas.Left>
                            <TextBlock Text="{Binding SelectionStartFrame}"
                                       Foreground="#FFCC00" FontSize="9" FontFamily="Consolas"/>
                        </Border>
                        <Border Canvas.Bottom="2" Background="#AA000000" CornerRadius="2" Padding="3,1">
                            <Canvas.Left>
                                <MultiBinding Converter="{StaticResource AddConverter}">
                                    <Binding Path="SelectionLeft"/>
                                    <Binding Path="SelectionWidth"/>
                                </MultiBinding>
                            </Canvas.Left>
                            <TextBlock Text="{Binding SelectionEndFrame}"
                                       Foreground="#FFCC00" FontSize="9" FontFamily="Consolas"/>
                        </Border>
                    </Canvas>

                    <!-- Data Curves with Visibility binding -->
                    <Polyline Points="{Binding PointsX}" Stroke="#E63946" StrokeThickness="1.2" Opacity="0.8"
                              Visibility="{Binding ShowXCurve, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Polyline Points="{Binding PointsY}" Stroke="#F1FA8C" StrokeThickness="1.2" Opacity="0.8"
                              Visibility="{Binding ShowYCurve, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Polyline Points="{Binding PointsZ}" Stroke="#00B4D8" StrokeThickness="1.2" Opacity="0.8"
                              Visibility="{Binding ShowZCurve, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Cursor (White Stroke) -->
                    <Canvas IsHitTestVisible="False">
                        <Line X1="{Binding CursorPosition}" Y1="0" X2="{Binding CursorPosition}" Y2="{Binding ViewHeight}" 
                              Stroke="White" StrokeThickness="2" Opacity="0.8"/>
                        
                        <!-- Value Display -->
                        <StackPanel Canvas.Left="{Binding CursorPosition}" Canvas.Top="5" 
                                    Visibility="{Binding IsValueVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Background="#AA000000" CornerRadius="2" Padding="2,0" Margin="4,0,0,1"
                                    Visibility="{Binding ShowXCurve, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentXValue}" Foreground="#E63946" FontSize="9" FontFamily="Consolas"/>
                            </Border>
                            <Border Background="#AA000000" CornerRadius="2" Padding="2,0" Margin="4,0,0,1"
                                    Visibility="{Binding ShowYCurve, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentYValue}" Foreground="#F1FA8C" FontSize="9" FontFamily="Consolas"/>
                            </Border>
                            <Border Background="#AA000000" CornerRadius="2" Padding="2,0" Margin="4,0,0,1"
                                    Visibility="{Binding ShowZCurve, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentZValue}" Foreground="#00B4D8" FontSize="9" FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>
                    </Canvas>
                    
                    <!-- Axis Labels (bottom right) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="5">
                        <TextBlock Text="X" Foreground="#E63946" FontSize="9" Margin="5,0"
                                   Visibility="{Binding ShowXCurve, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="Y" Foreground="#F1FA8C" FontSize="9" Margin="5,0"
                                   Visibility="{Binding ShowYCurve, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="Z" Foreground="#00B4D8" FontSize="9" Margin="5,0"
                                   Visibility="{Binding ShowZCurve, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
                
                <!-- SEPARATION MODE: 3 columns for X, Y, Z -->
                <Grid Visibility="{Binding IsSeparationMode, Converter={StaticResource BoolToVisibilityConverter}}"
                      behaviors:SizeObserverBehavior.IsEnabled="True"
                      behaviors:SizeObserverBehavior.ObservedWidth="{Binding ViewWidth, Mode=OneWayToSource}"
                      behaviors:SizeObserverBehavior.ObservedHeight="{Binding ViewHeight, Mode=OneWayToSource}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- X Column -->
                    <Grid Grid.Column="0" Background="Transparent"
                          behaviors:MouseSeekBehavior.IsEnabled="True"
                          behaviors:MouseSeekBehavior.SeekCommand="{Binding SeekCommand}"
                          behaviors:RangeSelectionBehavior.IsEnabled="{Binding IsEditModeEnabled}"
                          behaviors:RangeSelectionBehavior.StartSelectionCommand="{Binding StartSelectionCommand}"
                          behaviors:RangeSelectionBehavior.UpdateSelectionCommand="{Binding UpdateSelectionCommand}"
                          behaviors:RangeSelectionBehavior.EndSelectionCommand="{Binding EndSelectionCommand}">
                        <Control Template="{StaticResource GridLinesTemplate}"/>
                        
                        <!-- Range Labels (Left) -->
                        <TextBlock Text="{Binding YAxisMax_SepX}" Foreground="#E63946" FontSize="8" FontFamily="Consolas" Opacity="0.7"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2"/>
                        <TextBlock Text="{Binding YAxisMin_SepX}" Foreground="#E63946" FontSize="8" FontFamily="Consolas" Opacity="0.7"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="2"/>

                        <!-- Selection Highlight -->
                        <Canvas IsHitTestVisible="False" Visibility="{Binding SelectionVisibility}">
                            <Rectangle Canvas.Left="{Binding SelectionLeft_Sep}"
                                       Width="{Binding SelectionWidth_Sep}"
                                       Height="{Binding ViewHeight}"
                                       Fill="#40808000"/>
                            <Line X1="{Binding SelectionLeft_Sep}" Y1="0" 
                                  X2="{Binding SelectionLeft_Sep}" Y2="{Binding ViewHeight}"
                                  Stroke="#CCCC00" StrokeThickness="1"/>
                        </Canvas>
                        <Polyline Points="{Binding PointsX_Sep}" Stroke="#E63946" StrokeThickness="1.2" Opacity="0.8"/>
                        <Canvas IsHitTestVisible="False">
                            <Line X1="{Binding CursorPosition_Sep}" Y1="0" X2="{Binding CursorPosition_Sep}" Y2="{Binding ViewHeight}" 
                                  Stroke="White" StrokeThickness="2" Opacity="0.8"/>
                            <!-- Value Label X -->
                            <Border Canvas.Left="{Binding CursorPosition_Sep}" Canvas.Top="5" 
                                    Background="#AA000000" CornerRadius="2" Padding="2,0" Margin="4,0,0,0"
                                    Visibility="{Binding IsValueVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentXValue}" Foreground="#E63946" FontSize="9" FontFamily="Consolas"/>
                            </Border>
                        </Canvas>
                        <!-- Title (Bottom Right) -->
                        <TextBlock Text="X" Foreground="#E63946" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="5"/>
                    </Grid>
                    
                    <!-- Separator 1 -->
                    <Rectangle Grid.Column="1" Fill="#333333"/>
                    
                    <!-- Y Column -->
                    <Grid Grid.Column="2" Background="Transparent"
                          behaviors:MouseSeekBehavior.IsEnabled="True"
                          behaviors:MouseSeekBehavior.SeekCommand="{Binding SeekCommand}"
                          behaviors:RangeSelectionBehavior.IsEnabled="{Binding IsEditModeEnabled}"
                          behaviors:RangeSelectionBehavior.StartSelectionCommand="{Binding StartSelectionCommand}"
                          behaviors:RangeSelectionBehavior.UpdateSelectionCommand="{Binding UpdateSelectionCommand}"
                          behaviors:RangeSelectionBehavior.EndSelectionCommand="{Binding EndSelectionCommand}">
                        <Control Template="{StaticResource GridLinesTemplate}"/>

                        <!-- Range Labels (Left) -->
                        <TextBlock Text="{Binding YAxisMax_SepY}" Foreground="#F1FA8C" FontSize="8" FontFamily="Consolas" Opacity="0.7"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2"/>
                        <TextBlock Text="{Binding YAxisMin_SepY}" Foreground="#F1FA8C" FontSize="8" FontFamily="Consolas" Opacity="0.7"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="2"/>

                        <!-- Selection Highlight -->
                        <Canvas IsHitTestVisible="False" Visibility="{Binding SelectionVisibility}">
                            <Rectangle Canvas.Left="{Binding SelectionLeft_Sep}"
                                       Width="{Binding SelectionWidth_Sep}"
                                       Height="{Binding ViewHeight}"
                                       Fill="#40808000"/>
                            <Line X1="{Binding SelectionLeft_Sep}" Y1="0" 
                                  X2="{Binding SelectionLeft_Sep}" Y2="{Binding ViewHeight}"
                                  Stroke="#CCCC00" StrokeThickness="1"/>
                        </Canvas>
                        <Polyline Points="{Binding PointsY_Sep}" Stroke="#F1FA8C" StrokeThickness="1.2" Opacity="0.8"/>
                        <Canvas IsHitTestVisible="False">
                            <Line X1="{Binding CursorPosition_Sep}" Y1="0" X2="{Binding CursorPosition_Sep}" Y2="{Binding ViewHeight}" 
                                  Stroke="White" StrokeThickness="2" Opacity="0.8"/>
                            <!-- Value Label Y -->
                            <Border Canvas.Left="{Binding CursorPosition_Sep}" Canvas.Top="5" 
                                    Background="#AA000000" CornerRadius="2" Padding="2,0" Margin="4,0,0,0"
                                    Visibility="{Binding IsValueVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentYValue}" Foreground="#F1FA8C" FontSize="9" FontFamily="Consolas"/>
                            </Border>
                        </Canvas>
                        <!-- Title (Bottom Right) -->
                        <TextBlock Text="Y" Foreground="#F1FA8C" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="5"/>
                    </Grid>
                    
                    <!-- Separator 2 -->
                    <Rectangle Grid.Column="3" Fill="#333333"/>
                    
                    <!-- Z Column -->
                    <Grid Grid.Column="4" Background="Transparent"
                          behaviors:MouseSeekBehavior.IsEnabled="True"
                          behaviors:MouseSeekBehavior.SeekCommand="{Binding SeekCommand}"
                          behaviors:RangeSelectionBehavior.IsEnabled="{Binding IsEditModeEnabled}"
                          behaviors:RangeSelectionBehavior.StartSelectionCommand="{Binding StartSelectionCommand}"
                          behaviors:RangeSelectionBehavior.UpdateSelectionCommand="{Binding UpdateSelectionCommand}"
                          behaviors:RangeSelectionBehavior.EndSelectionCommand="{Binding EndSelectionCommand}">
                        <Control Template="{StaticResource GridLinesTemplate}"/>

                        <!-- Range Labels (Left) -->
                        <TextBlock Text="{Binding YAxisMax_SepZ}" Foreground="#00B4D8" FontSize="8" FontFamily="Consolas" Opacity="0.7"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2"/>
                        <TextBlock Text="{Binding YAxisMin_SepZ}" Foreground="#00B4D8" FontSize="8" FontFamily="Consolas" Opacity="0.7"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="2"/>

                        <!-- Selection Highlight -->
                        <Canvas IsHitTestVisible="False" Visibility="{Binding SelectionVisibility}">
                            <Rectangle Canvas.Left="{Binding SelectionLeft_Sep}"
                                       Width="{Binding SelectionWidth_Sep}"
                                       Height="{Binding ViewHeight}"
                                       Fill="#40808000"/>
                            <Line X1="{Binding SelectionLeft_Sep}" Y1="0" 
                                  X2="{Binding SelectionLeft_Sep}" Y2="{Binding ViewHeight}"
                                  Stroke="#CCCC00" StrokeThickness="1"/>
                        </Canvas>
                        <Polyline Points="{Binding PointsZ_Sep}" Stroke="#00B4D8" StrokeThickness="1.2" Opacity="0.8"/>
                        <Canvas IsHitTestVisible="False">
                            <Line X1="{Binding CursorPosition_Sep}" Y1="0" X2="{Binding CursorPosition_Sep}" Y2="{Binding ViewHeight}" 
                                  Stroke="White" StrokeThickness="2" Opacity="0.8"/>
                            <!-- Value Label Z -->
                            <Border Canvas.Left="{Binding CursorPosition_Sep}" Canvas.Top="5" 
                                    Background="#AA000000" CornerRadius="2" Padding="2,0" Margin="4,0,0,0"
                                    Visibility="{Binding IsValueVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentZValue}" Foreground="#00B4D8" FontSize="9" FontFamily="Consolas"/>
                            </Border>
                        </Canvas>
                        <!-- Title (Bottom Right) -->
                        <TextBlock Text="Z" Foreground="#00B4D8" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="5"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
