<UserControl x:Class="MStudio.App.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:MStudio.App.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    <Grid Background="#1A1A1A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>  <!-- Y-axis labels -->
            <ColumnDefinition Width="*"/>   <!-- Graph area -->
        </Grid.ColumnDefinitions>

        <!-- Y-Axis Labels -->
        <Grid Grid.Column="0" Margin="2,5">
            <TextBlock Text="{Binding YAxisMax}" Foreground="{DynamicResource B_TextDim}" 
                       FontSize="9" FontFamily="Consolas"
                       VerticalAlignment="Top" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding YAxisMid}" Foreground="{DynamicResource B_TextDim}" 
                       FontSize="9" FontFamily="Consolas"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding YAxisMin}" Foreground="{DynamicResource B_TextDim}" 
                       FontSize="9" FontFamily="Consolas"
                       VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Graph Area with Behaviors (Clean Architecture: no code-behind needed) -->
        <!-- Background="Transparent" is required for mouse hit testing on the Grid -->
        <Grid Grid.Column="1" x:Name="GraphArea"
              Background="Transparent"
              behaviors:SizeObserverBehavior.IsEnabled="True"
              behaviors:SizeObserverBehavior.ObservedWidth="{Binding ViewWidth, Mode=OneWayToSource}"
              behaviors:SizeObserverBehavior.ObservedHeight="{Binding ViewHeight, Mode=OneWayToSource}"
              behaviors:MouseSeekBehavior.IsEnabled="True"
              behaviors:MouseSeekBehavior.SeekCommand="{Binding SeekCommand}">
            <!-- Background Grid Lines -->
            <Canvas Opacity="0.15">
                <Line X1="0" Y1="25" X2="10000" Y2="25" Stroke="White" StrokeThickness="1" StrokeDashArray="4,4"/>
                <Line X1="0" Y1="50" X2="10000" Y2="50" Stroke="White" StrokeThickness="1"/>
                <Line X1="0" Y1="75" X2="10000" Y2="75" Stroke="White" StrokeThickness="1" StrokeDashArray="4,4"/>
            </Canvas>

            <!-- Data Curves -->
            <Polyline Points="{Binding PointsX}" Stroke="#E63946" StrokeThickness="1.2" Opacity="0.8"/>
            <Polyline Points="{Binding PointsY}" Stroke="#F1FA8C" StrokeThickness="1.2" Opacity="0.8"/>
            <Polyline Points="{Binding PointsZ}" Stroke="#00B4D8" StrokeThickness="1.2" Opacity="0.8"/>

            <!-- Cursor -->
            <Canvas IsHitTestVisible="False">
                <Line X1="{Binding CursorPosition}" Y1="0" X2="{Binding CursorPosition}" Y2="{Binding ViewHeight}" 
                      Stroke="{DynamicResource B_Accent}" StrokeThickness="2" Opacity="0.8"/>
            </Canvas>

            <!-- Labels Overlay -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5">
                <TextBlock Text="X" Foreground="#E63946" FontSize="9" Margin="5,0"/>
                <TextBlock Text="Y" Foreground="#F1FA8C" FontSize="9" Margin="5,0"/>
                <TextBlock Text="Z" Foreground="#00B4D8" FontSize="9" Margin="5,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

