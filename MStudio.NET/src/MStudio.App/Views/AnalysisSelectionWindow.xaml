<Window x:Class="MStudio.App.Views.AnalysisSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Analysis Type"
        Width="700" Height="500"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#3A3A5A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (draggable for window move) -->
            <Border Grid.Row="0" Background="#252535" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Path Data="M12,2 L4,2 L4,22 L20,22 L20,8 L12,2 M12,2 L12,8 L20,8" 
                          Stroke="#6C9BDB" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="Movement Analysis" FontSize="18" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="1" Content="✕" Width="40" Height="40" Click="CloseButton_Click"
                        Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="16" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="0,12,0,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                </Grid>
            </Border>

            <!-- Subtitle -->
            <TextBlock Grid.Row="1" Text="Select the type of movement you want to analyze" 
                       Foreground="#888" FontSize="13" Margin="20,15,20,10"/>

            <!-- Analysis Cards Grid -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="15,5,15,15">
                <ItemsControl x:Name="AnalysisCards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="8" Width="200" Height="130" Click="AnalysisCard_Click" Tag="{Binding Type}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder" Background="#2A2A3E" CornerRadius="10" 
                                                BorderBrush="#3A3A5A" BorderThickness="1" Padding="15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Icon -->
                                                <Border Grid.Row="0" Width="45" Height="45" CornerRadius="8" 
                                                        Background="{Binding IconBackground}" HorizontalAlignment="Left">
                                                    <Path Data="{Binding IconData}" 
                                                          Stroke="{Binding IconColor}" StrokeThickness="2" 
                                                          Width="24" Height="24" Stretch="Uniform"/>
                                                </Border>
                                                
                                                <!-- Title -->
                                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" 
                                                           Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Bottom" Margin="0,8,0,4"
                                                           TextWrapping="Wrap"/>
                                                
                                                <!-- Description -->
                                                <TextBlock Grid.Row="2" Text="{Binding ShortDescription}" 
                                                           Foreground="#666" FontSize="11"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           MaxHeight="30"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#353550"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#5A5A7A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#404060"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#252535" CornerRadius="0,0,12,12" Padding="20,12">
                <Grid>
                    <TextBlock Text="More analysis types coming soon..." Foreground="#555" FontSize="11" 
                               VerticalAlignment="Center" FontStyle="Italic"/>
                    <Button Content="Cancel" HorizontalAlignment="Right" Width="80" Height="30" Click="CloseButton_Click"
                            Background="#3A3A5A" Foreground="#AAA" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4A4A6A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
