<Window x:Class="MStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MStudio.App"
        xmlns:views="clr-namespace:MStudio.App.Views"
        xmlns:behaviors="clr-namespace:MStudio.App.Behaviors"
        xmlns:converters="clr-namespace:MStudio.App.Converters"
        xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:dockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:vs2013="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:reskeys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013"
        mc:Ignorable="d"
        Title="Motive" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B_Background}"
        behaviors:GlobalKeyboardBehavior.IsEnabled="True"
        behaviors:GlobalKeyboardBehavior.LeftKeyCommand="{Binding StepBackwardCommand}"
        behaviors:GlobalKeyboardBehavior.RightKeyCommand="{Binding StepForwardCommand}"
        behaviors:GlobalKeyboardBehavior.SpaceKeyCommand="{Binding TogglePlayCommand}">
    
    <Window.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Menu Bar -->
            <RowDefinition Height="Auto"/>  <!-- Icon Toolbar -->
            <RowDefinition Height="*"/>     <!-- Main Workspace -->
            <RowDefinition Height="Auto"/>  <!-- Timeline/Graph -->
            <RowDefinition Height="Auto"/>  <!-- Transport Controls -->
            <RowDefinition Height="24"/>    <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- ROW 0: MENU BAR (File, Edit, View, Layout, Help) -->
        <!-- ============================================================ -->
        <Menu Grid.Row="0" Style="{DynamicResource MotiveMenuStyle}">
            <MenuItem Header="_File">
                <MenuItem Header="New Session"/>
                <MenuItem Header="Open..." Command="{Binding OpenFileCommand}"/>
                <Separator/>
                <MenuItem Header="Exit"/>
            </MenuItem>
            <MenuItem Header="_Edit"/>
            <MenuItem Header="_View"/>
            <MenuItem Header="_Layout"/>
            <MenuItem Header="_Help"/>
        </Menu>

        <!-- ============================================================ -->
        <!-- ROW 1: ICON TOOLBAR -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Background="{DynamicResource B_Panel}" BorderThickness="0" Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <!-- File Operations -->
                <Button Style="{DynamicResource ToolbarIconButton}" ToolTip="New">
                    <Rectangle Width="12" Height="12" Stroke="{DynamicResource B_IconDark}" StrokeThickness="1"/>
                </Button>
                <Button Style="{DynamicResource ToolbarIconButton}" ToolTip="Open" Command="{Binding OpenFileCommand}">
                    <Path Data="M1,4 L1,12 L11,12 L11,4 L6,4 L5,2 L1,2 Z" Stroke="{DynamicResource B_IconDark}" StrokeThickness="1" Fill="Transparent"/>
                </Button>
                <Button Style="{DynamicResource ToolbarIconButton}" ToolTip="Save">
                    <Path Data="M2,1 L2,11 L10,11 L10,3 L8,1 Z M4,1 L4,4 L8,4" Stroke="{DynamicResource B_IconDark}" StrokeThickness="1" Fill="Transparent"/>
                </Button>
                
                <Rectangle Width="1" Height="16" Fill="{DynamicResource B_Separator}" Margin="6,0"/>
                
                <!-- Selection Tools -->
                <Button Style="{DynamicResource ToolbarIconButton}" ToolTip="Select">
                    <Path Data="M1,1 L1,11 L4,8 L6,11 L8,10 L6,7 L10,7 Z" Stroke="{DynamicResource B_IconDark}" StrokeThickness="1" Fill="Transparent"/>
                </Button>
                <Button Style="{DynamicResource ToolbarIconButton}" ToolTip="Move">
                    <Path Data="M6,1 L6,11 M1,6 L11,6 M6,1 L4,3 M6,1 L8,3 M6,11 L4,9 M6,11 L8,9 M1,6 L3,4 M1,6 L3,8 M11,6 L9,4 M11,6 L9,8" Stroke="{DynamicResource B_IconDark}" StrokeThickness="1"/>
                </Button>
                <Button Style="{DynamicResource ToolbarIconButton}" ToolTip="Rotate">
                    <Path Data="M10,6 A 4,4 0 1 1 6,2 M6,0 L6,4 L10,2" Stroke="{DynamicResource B_IconDark}" StrokeThickness="1" Fill="Transparent"/>
                </Button>
                
                <Rectangle Width="1" Height="16" Fill="{DynamicResource B_Separator}" Margin="6,0"/>
                
                <!-- View Options -->
                <Button Style="{DynamicResource ToolbarIconButton}" ToolTip="Fit All">
                    <Path Data="M1,1 L4,1 M1,1 L1,4 M11,1 L8,1 M11,1 L11,4 M1,11 L4,11 M1,11 L1,8 M11,11 L8,11 M11,11 L11,8" Stroke="{DynamicResource B_IconDark}" StrokeThickness="1"/>
                </Button>
                <Button Style="{DynamicResource ToolbarIconButton}" ToolTip="Outliers">
                    <Ellipse Width="10" Height="10" Stroke="{DynamicResource B_Accent}" StrokeThickness="1.5"/>
                </Button>
                
                <Rectangle Width="1" Height="16" Fill="{DynamicResource B_Separator}" Margin="6,0"/>
                
                <!-- 3x Button (Like Motive) -->
                <Button Style="{DynamicResource ToolbarIconButton}" Width="Auto" Padding="8,4" ToolTip="Trajectory Display">
                    <TextBlock Text="3x" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource B_Text}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 2: MAIN WORKSPACE (AvalonDock) -->
        <!-- ============================================================ -->
        <dock:DockingManager Grid.Row="2" Background="{DynamicResource B_Background}">
            <dock:DockingManager.Theme>
                <vs2013:Vs2013DarkTheme/>
            </dock:DockingManager.Theme>
            <dock:DockingManager.Resources>
                <!-- Override VS2013 Accent Colors with subtle dark grey -->
                <Color x:Key="{x:Static reskeys:ResourceKeys.ControlAccentColorKey}">#3A3A3A</Color>
                <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ControlAccentBrushKey}" Color="#3A3A3A"/>
                <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedActiveBackground}" Color="#3A3A3A"/>
                <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabUnselectedHoveredBackground}" Color="#333333"/>
                <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowCaptionActiveBackground}" Color="#3A3A3A"/>
                <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowCaptionActiveText}" Color="#CCCCCC"/>
                
                <!-- Broad targeting to catch any internal AvalonDock UI elements -->
                <Style TargetType="{x:Type Control}">
                    <Setter Property="Background" Value="{DynamicResource B_Panel}"/>
                    <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </dock:DockingManager.Resources>
            <layout:LayoutRoot>
                <layout:LayoutPanel Orientation="Horizontal">
                    
                    <!-- LEFT PANEL: Trials -->
                    <layout:LayoutAnchorablePane DockWidth="220">
                        <layout:LayoutAnchorable Title="Trials" CanClose="False">
                            <Grid Background="{DynamicResource B_Panel}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Toolbar -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4" Background="#2A2A2A">
                                    <Button Content="Select All" Command="{Binding SelectAllTrialsCommand}" 
                                            Style="{DynamicResource ToolbarIconButton}" Width="Auto" Padding="6,2" Margin="2"/>
                                    <Button Content="Deselect" Command="{Binding DeselectAllTrialsCommand}" 
                                            Style="{DynamicResource ToolbarIconButton}" Width="Auto" Padding="6,2" Margin="2"/>
                                    <Button Content="Clear" Command="{Binding ClearAllTrialsCommand}" 
                                            Style="{DynamicResource ToolbarIconButton}" Width="Auto" Padding="6,2" Margin="2"/>
                                </StackPanel>
                                
                                <!-- Column Headers -->
                                <Grid Grid.Row="1" Background="#2A2A2A" Height="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="✓" Foreground="{DynamicResource B_TextDim}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="Trial Name" Foreground="{DynamicResource B_TextDim}" 
                                               VerticalAlignment="Center" Margin="4,0"/>
                                </Grid>
                                
                                <!-- Trial List -->
                                <ListBox Grid.Row="2" 
                                         ItemsSource="{Binding Trials}" 
                                         Background="Transparent" 
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#3A3A3A"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#333333"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Selection Checkbox -->
                                                <CheckBox Grid.Column="0" 
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,4,0"/>
                                                
                                                <!-- Trial Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" 
                                                               Foreground="{DynamicResource B_Text}" 
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding SummaryText}"/>
                                                    <TextBlock Text="{Binding DurationText}" 
                                                               Foreground="{DynamicResource B_TextDim}" 
                                                               FontSize="9"/>
                                                </StackPanel>
                                                
                                                <!-- Color Indicator -->
                                                <Ellipse Grid.Column="2" 
                                                         Width="8" Height="8" 
                                                         Fill="{Binding TrialBrush}"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                
                                <!-- Empty State -->
                                <TextBlock Grid.Row="2" 
                                           Text="No trials loaded.&#x0a;Use File → Open to add trials."
                                           Foreground="{DynamicResource B_TextDim}"
                                           FontSize="10"
                                           FontStyle="Italic"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding HasTrials, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </Grid>
                        </layout:LayoutAnchorable>
                        
                        <layout:LayoutAnchorable Title="Data" CanClose="False">
                            <views:DataView DataContext="{Binding DataViewModel}"/>
                        </layout:LayoutAnchorable>
                    </layout:LayoutAnchorablePane>

                    <!-- CENTER: Viewport -->
                    <layout:LayoutDocumentPaneGroup>
                        <layout:LayoutDocumentPane>
                            <layout:LayoutDocument Title="Perspective" CanClose="False">
                                <views:ViewportView DataContext="{Binding ViewportViewModel}"/>
                            </layout:LayoutDocument>
                        </layout:LayoutDocumentPane>
                    </layout:LayoutDocumentPaneGroup>

                    <!-- RIGHT PANEL: Edit Tools -->
                    <layout:LayoutAnchorablePane DockWidth="220">
                        <layout:LayoutAnchorable Title="Edit Tools" CanClose="False">
                            <ScrollViewer Background="{DynamicResource B_Panel}" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    
                                    <!-- Tails Section -->
                                    <TextBlock Text="▼ Tails" Style="{DynamicResource SectionLabel}"/>
                                    <Grid Margin="10,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Leading/Trailing Frames:" Foreground="{DynamicResource B_TextDim}"/>
                                        <TextBox Grid.Column="1" Text="3" Style="{DynamicResource FlatTextBox}"/>
                                        <TextBlock Grid.Column="2" Text="  Trim Range" Foreground="{DynamicResource B_Accent}" Cursor="Hand"/>
                                    </Grid>
                                    <Grid Margin="10,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Smart Trim:" Foreground="{DynamicResource B_TextDim}"/>
                                        <CheckBox Grid.Column="1" IsChecked="True"/>
                                    </Grid>
                                    
                                    <Separator Background="#3A3A3A" Margin="0,10"/>
                                    
                                    <!-- Gaps Section -->
                                    <TextBlock Style="{DynamicResource SectionLabel}">
                                        <Run Text="▼ Gaps"/>
                                        <Run Text="     Previous  Next  Fill Range" Foreground="{DynamicResource B_Accent}"/>
                                    </TextBlock>
                                    <Grid Margin="10,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Interpolation Type:" Foreground="{DynamicResource B_TextDim}"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="0" Background="Transparent" BorderThickness="0">
                                            <ComboBoxItem Content="Cubic"/>
                                            <ComboBoxItem Content="Linear"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="10,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Maximum Gap Size:" Foreground="{DynamicResource B_TextDim}"/>
                                        <TextBox Grid.Column="1" Text="100" Style="{DynamicResource FlatTextBox}"/>
                                    </Grid>
                                    <Button Content="Fill Current Marker Gaps" Command="{Binding FillGapsCommand}" 
                                            Style="{DynamicResource ActionButton}" Margin="10,5,0,5" HorizontalAlignment="Left"/>
                                    
                                    <Separator Background="{DynamicResource B_Separator}" Margin="0,10"/>
                                    
                                    <!-- Curves Section -->
                                    <TextBlock Style="{DynamicResource SectionLabel}">
                                        <Run Text="▼ Curves"/>
                                        <Run Text="           Smooth Range" Foreground="{DynamicResource B_Accent}"/>
                                    </TextBlock>
                                    <Grid Margin="10,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Maximum Frequency:" Foreground="{DynamicResource B_TextDim}"/>
                                        <TextBox Grid.Column="1" Text="6 Hz" Style="{DynamicResource FlatTextBox}"/>
                                    </Grid>
                                    <Button Content="Smooth Selected Marker" Command="{Binding SmoothDataCommand}" 
                                            Style="{DynamicResource ActionButton}" Margin="10,5,0,5" HorizontalAlignment="Left"/>
                                    
                                    <!-- Note: Marker selection is now done by clicking directly in the 3D viewport -->
                                    
                                </StackPanel>
                            </ScrollViewer>
                        </layout:LayoutAnchorable>
                    </layout:LayoutAnchorablePane>

                </layout:LayoutPanel>
            </layout:LayoutRoot>
        </dock:DockingManager>

        <!-- ============================================================ -->
        <!-- ROW 3: GRAPH VIEW (Collapsed by default, can be expanded) -->
        <!-- ============================================================ -->
        <Border Grid.Row="3" Height="100" Background="{DynamicResource B_Panel}" BorderBrush="{DynamicResource B_BorderDark}" BorderThickness="0,1,0,0">
            <views:GraphView DataContext="{Binding GraphViewModel}"/>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 4: TRANSPORT CONTROLS (Timeline Slider + Buttons) -->
        <!-- ============================================================ -->
        <Border Grid.Row="4" Background="{DynamicResource B_Panel}" BorderBrush="{DynamicResource B_BorderDark}" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Transport Buttons -->
                    <ColumnDefinition Width="Auto"/>   <!-- Timecode -->
                    <ColumnDefinition Width="*"/>      <!-- (spacer) -->
                    <ColumnDefinition Width="Auto"/>   <!-- LOOP / REVERSE -->
                    <ColumnDefinition Width="Auto"/>   <!-- Frame Range -->
                </Grid.ColumnDefinitions>

                <!-- Transport Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource TransportButton}" Command="{Binding StepBackwardCommand}">
                        <Path Data="{StaticResource Geo_StepBwd}" Fill="{DynamicResource B_Text}" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{DynamicResource TransportButton}" Command="{Binding TogglePlayCommand}" Margin="5,0">
                        <Path Fill="{DynamicResource B_Text}" Width="12" Height="12" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource Geo_Play}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Geo_Pause}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{DynamicResource TransportButton}" Command="{Binding StepForwardCommand}">
                        <Path Data="{StaticResource Geo_StepFwd}" Fill="{DynamicResource B_Text}" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Timecode Display (like Motive: 0:03:07:101) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock FontFamily="Consolas" FontSize="18" Foreground="{DynamicResource B_Text}">
                        <Run Text="0:"/>
                        <Run Text="{Binding CurrentTimeText, Mode=OneWay}" Foreground="{DynamicResource B_Text}"/>
                    </TextBlock>
                    <TextBlock Text="  " FontFamily="Consolas" FontSize="18"/>
                    <TextBlock Text="{Binding CurrentFrame}" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource B_Text}"/>
                </StackPanel>

                <!-- LOOP / REVERSE -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- LOOP Toggle -->
                    <ToggleButton IsChecked="{Binding IsLooping}" BorderThickness="0" Background="Transparent" Margin="0,0,15,0" Cursor="Hand" Focusable="False">
                        <ToggleButton.Template>
                             <ControlTemplate TargetType="ToggleButton">
                                 <TextBlock Text="LOOP" FontSize="10" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                             </ControlTemplate>
                        </ToggleButton.Template>
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Foreground" Value="{DynamicResource B_TextDim}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource B_Accent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- REVERSE Toggle -->
                    <ToggleButton IsChecked="{Binding IsReverse}" BorderThickness="0" Background="Transparent" Margin="0,0,15,0" Cursor="Hand" Focusable="False">
                        <ToggleButton.Template>
                             <ControlTemplate TargetType="ToggleButton">
                                 <TextBlock Text="REVERSE" FontSize="10" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                             </ControlTemplate>
                        </ToggleButton.Template>
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Foreground" Value="{DynamicResource B_TextDim}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource B_Accent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    
                    <TextBlock Text="Speed" FontSize="10" Foreground="{DynamicResource B_TextDim}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding PlaybackSpeed, StringFormat={}{0:F1}x}" FontSize="10" Foreground="{DynamicResource B_Text}" VerticalAlignment="Center" Margin="0,0,5,0" Width="30"/>
                    <Slider Width="100" Minimum="0" Maximum="10" Value="{Binding PlaybackSpeed}" 
                            TickFrequency="0.1" IsSnapToTickEnabled="False"
                            VerticalAlignment="Center" Focusable="False"/>
                    <Button Content="1x" Style="{DynamicResource ToolbarIconButton}" Width="24" Height="20" FontSize="9"
                            Command="{Binding ResetSpeedCommand}" Margin="5,0,0,0">
                    </Button>
                </StackPanel>

                <!-- Frame Range -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentFrame}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource B_Accent}"/>
                    <TextBlock Text=" ▸ " FontSize="9" Foreground="{DynamicResource B_TextDim}"/>
                    <TextBlock Text="{Binding TotalFrames}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource B_Text}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 5: STATUS BAR (Take Name, LIVE/REC, Software stats) -->
        <!-- ============================================================ -->
        <Border Grid.Row="5" Background="#1E1E1E" BorderBrush="Black" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LIVE Button -->
                <Border Background="{DynamicResource B_Green}" CornerRadius="2" Padding="8,2" Margin="5,2">
                    <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                </Border>
                
                <!-- REC Button (Muted) -->
                <Border Grid.Column="1" Background="#444" CornerRadius="2" Padding="8,2" Margin="2">
                    <TextBlock Text="REC" FontSize="10" FontWeight="Bold" Foreground="#888"/>
                </Border>

                <!-- Take Name -->
                <TextBlock Grid.Column="2" Text="Take Name: Session_001" FontSize="10" Foreground="{DynamicResource B_TextDim}" VerticalAlignment="Center" Margin="15,0"/>

                <!-- Software Stats (Right) -->
                <TextBlock Grid.Column="4" FontSize="10" Foreground="{DynamicResource B_TextDim}" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Run Text="Software: "/>
                    <Run Text="3.2 ms" Foreground="{DynamicResource B_Text}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
